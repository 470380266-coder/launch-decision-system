generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  PURCHASER
  VIEWER
}

enum BasicStatus {
  ACTIVE
  INACTIVE
}

enum ProductState {
  LAUNCHABLE
  SCHEDULABLE
  BLOCKED
  COMPLETED
}

enum ProductionBatchStatus {
  PENDING
  PAUSED
  COMPLETED
}

enum RunType {
  SCHEDULED
  MANUAL
}

enum CalcRunStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum ProcurementOrderStatus {
  NOT_ORDERED
  ORDERED
  PARTIAL
  COMPLETED
}

enum ProcurementProductionStatus {
  NOT_STARTED
  IN_PRODUCTION
  READY_TO_SHIP
  SHIPPED
  ARRIVED
}

enum StockingRequestStatus {
  CONFIRMED
  ALLOCATED
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  name         String
  username     String   @unique
  passwordHash String
  role         UserRole
  status       BasicStatus @default(ACTIVE)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  receiptBatches          MaterialReceiptBatch[]
  sharedMaterialAllocations SharedMaterialAllocation[]
  procurementTracks       MaterialProcurementTrack[]
  stockingRequests        StockingRequest[]
  launchAllocations       LaunchAllocation[]
}

model Product {
  id                       String   @id @default(cuid())
  productCode              String   @unique
  productName              String
  productSpec              String?
  unit                     String   @default("pcs")
  status                   BasicStatus @default(ACTIVE)
  minStartQty              Int
  standardProductionDays   Int
  bufferDays               Int
  shortWindowDays          Int? 
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  bomVersions              BomVersion[]
  receiptBatchLinks        ReceiptBatchLink[]
  productionBatches        ProductionBatch[]
  snapshots                ProductSnapshot[]
  procurementTracks        MaterialProcurementTrack[]
  stockingRequests         StockingRequest[]
  launchAllocations        LaunchAllocation[]
}

model Material {
  id                String   @id @default(cuid())
  materialCode      String   @unique
  materialName      String
  materialSpec      String?
  unit              String
  status            BasicStatus @default(ACTIVE)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  bomItems          BomItem[]
  receiptBatches    MaterialReceiptBatch[]
  procurementTracks MaterialProcurementTrack[]
}

model BomVersion {
  id             String   @id @default(cuid())
  productId      String
  versionNo      String
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  isActive       Boolean  @default(false)
  remark         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product        Product  @relation(fields: [productId], references: [id])
  items          BomItem[]
  productionBatches ProductionBatch[]
  procurementTracks MaterialProcurementTrack[]
  stockingRequests StockingRequest[]
}

model StockingRequest {
  id                  String   @id @default(cuid())
  productId           String
  bomVersionId        String
  requestNo           String   @unique
  targetFinishedQty   Float
  requestedByUserId   String
  requestedAt         DateTime
  status              StockingRequestStatus @default(CONFIRMED)
  remark              String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  product             Product @relation(fields: [productId], references: [id])
  bomVersion          BomVersion @relation(fields: [bomVersionId], references: [id])
  requestedBy         User @relation(fields: [requestedByUserId], references: [id])
  procurementTracks   MaterialProcurementTrack[]
  productionBatches    ProductionBatch[]
  launchAllocations    LaunchAllocation[]
  snapshots            ProductSnapshot[]
}

model BomItem {
  id                String   @id @default(cuid())
  bomVersionId      String
  materialId        String
  unitUsage         Float
  isSharedMaterial  Boolean
  lossRate          Float?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  bomVersion        BomVersion @relation(fields: [bomVersionId], references: [id])
  material          Material   @relation(fields: [materialId], references: [id])
  receiptBatches    MaterialReceiptBatch[]
  procurementTracks MaterialProcurementTrack[]
}

model MaterialReceiptBatch {
  id                String   @id @default(cuid())
  materialId        String
  bomItemId         String?
  materialFollowUpId String?
  receiptBatchNo    String
  arrivedQty        Float
  arrivedAt         DateTime
  purchaserUserId   String
  sourceType        String
  note              String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  material          Material @relation(fields: [materialId], references: [id])
  bomItem           BomItem? @relation(fields: [bomItemId], references: [id])
  materialFollowUp  MaterialProcurementTrack? @relation("ReceiptFollowUp", fields: [materialFollowUpId], references: [id])
  purchaser         User @relation(fields: [purchaserUserId], references: [id])
  receiptBatchLinks ReceiptBatchLink[]
  sharedAllocations SharedMaterialAllocation[]
  procurementTracks MaterialProcurementTrack[] @relation("LatestTrackReceipt")
  procurementTrackReceipts ProcurementTrackReceipt[]
}

model MaterialProcurementTrack {
  id                    String   @id @default(cuid())
  productId             String
  materialId            String
  bomItemId             String?
  stockingRequestId     String?
  bomVersionId          String?
  purchaserUserId       String
  receiptBatchId        String?
  supplier              String?
  purchaseOrderNo       String?
  requiredQty           Float
  orderedQty            Float
  arrivedQty            Float    @default(0)
  orderStatus           ProcurementOrderStatus @default(NOT_ORDERED)
  productionStatus      ProcurementProductionStatus @default(NOT_STARTED)
  orderedAt             DateTime?
  expectedShipAt        DateTime?
  inTransitAt           DateTime?
  transitDays           Int?
  expectedArriveAt      DateTime?
  actualArriveAt        DateTime?
  receiptBatchNo        String?
  todoNote              String?
  nextFollowUpAt        DateTime?
  exceptionNote         String?
  note                  String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  product               Product @relation(fields: [productId], references: [id])
  material              Material @relation(fields: [materialId], references: [id])
  bomItem               BomItem? @relation(fields: [bomItemId], references: [id])
  stockingRequest       StockingRequest? @relation(fields: [stockingRequestId], references: [id])
  bomVersion            BomVersion? @relation(fields: [bomVersionId], references: [id])
  purchaser             User @relation(fields: [purchaserUserId], references: [id])
  receiptBatch          MaterialReceiptBatch? @relation("LatestTrackReceipt", fields: [receiptBatchId], references: [id])
  materialReceiptBatches MaterialReceiptBatch[] @relation("ReceiptFollowUp")
  receiptLinks          ProcurementTrackReceipt[]
}

model ProcurementTrackReceipt {
  id                    String   @id @default(cuid())
  procurementTrackId    String
  receiptBatchId        String
  arrivedQty            Float
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  procurementTrack      MaterialProcurementTrack @relation(fields: [procurementTrackId], references: [id])
  receiptBatch          MaterialReceiptBatch @relation(fields: [receiptBatchId], references: [id])

  @@unique([procurementTrackId, receiptBatchId])
}

model ReceiptBatchLink {
  id              String   @id @default(cuid())
  receiptBatchId  String
  productId       String
  linkedQty       Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  receiptBatch    MaterialReceiptBatch @relation(fields: [receiptBatchId], references: [id])
  product         Product @relation(fields: [productId], references: [id])
}

model ProductionBatch {
  id                   String   @id @default(cuid())
  productId            String
  bomVersionId         String
  stockingRequestId    String?
  batchNo              String
  plannedQty           Int
  batchStatus          ProductionBatchStatus
  predictedStartDate   DateTime?
  predictedFinishDate  DateTime?
  predictedLaunchDate  DateTime?
  blockingReason       String?
  generatedByRunId     String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  product              Product @relation(fields: [productId], references: [id])
  bomVersion           BomVersion @relation(fields: [bomVersionId], references: [id])
  stockingRequest      StockingRequest? @relation(fields: [stockingRequestId], references: [id])
  generatedByRun       CalcRun? @relation(fields: [generatedByRunId], references: [id])
  sharedAllocations    SharedMaterialAllocation[]
  actual               ProductionBatchActual?
}

model SharedMaterialAllocation {
  id                  String   @id @default(cuid())
  receiptBatchId      String
  productionBatchId   String
  allocatedQty        Float
  allocatedByUserId   String
  allocatedAt         DateTime
  note                String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  receiptBatch        MaterialReceiptBatch @relation(fields: [receiptBatchId], references: [id])
  productionBatch     ProductionBatch @relation(fields: [productionBatchId], references: [id])
  allocatedBy         User @relation(fields: [allocatedByUserId], references: [id])
}

model ProductSnapshot {
  id                        String   @id @default(cuid())
  productId                 String
  calcRunId                 String
  stockingRequestId         String?
  launchableQtyNow          Int
  launchableQtyShortTerm    Int
  roundLaunchQty            Int      @default(0)
  allocatedLaunchQty        Int      @default(0)
  remainingAllocatableQty   Int      @default(0)
  nextLaunchDate            DateTime?
  productState              ProductState
  reasonSummary             String
  createdAt                 DateTime @default(now())

  product                   Product @relation(fields: [productId], references: [id])
  calcRun                   CalcRun @relation(fields: [calcRunId], references: [id])
  stockingRequest           StockingRequest? @relation(fields: [stockingRequestId], references: [id])
}

model ProductionBatchActual {
  id                String   @id @default(cuid())
  productionBatchId String   @unique
  actualStartAt     DateTime?
  actualFinishAt    DateTime?
  actualLaunchAt    DateTime?
  actualLaunchQty   Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  productionBatch   ProductionBatch @relation(fields: [productionBatchId], references: [id])
}

model LaunchAllocation {
  id                  String   @id @default(cuid())
  stockingRequestId   String
  productId           String
  allocationTarget    String
  allocatedQty        Int
  allocatedByUserId   String
  allocatedAt         DateTime
  note                String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  stockingRequest     StockingRequest @relation(fields: [stockingRequestId], references: [id])
  product             Product @relation(fields: [productId], references: [id])
  allocatedBy         User @relation(fields: [allocatedByUserId], references: [id])
}

model CalcRun {
  id            String   @id @default(cuid())
  runType       RunType
  startedAt     DateTime
  finishedAt    DateTime?
  status        CalcRunStatus
  errorMessage  String?
  createdAt     DateTime @default(now())

  productionBatches ProductionBatch[]
  snapshots         ProductSnapshot[]
}
